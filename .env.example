# Run npm run init to generate independent secrets. Never put these in Flutter.
NODE_ENV=development
HOST=127.0.0.1
PORT=3080
PUBLIC_BASE_URL=http://127.0.0.1:3080
DATA_DIR=./data
ADMIN_PASSWORD=
# Base64 of 32 cryptographically random bytes. Back up alongside the database.
ENCRYPTION_KEY=
DRIVER_MODE=sandbox
CONNECTOR_CONFIG=./config/android.live.json
APPIUM_URL=http://127.0.0.1:4723
# ANDROID_HOME=/opt/android-sdk
# JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ANDROID_SYSTEM_IMAGE=system-images;android-35;google_apis_playstore;x86_64
LIVE_AUTOMATION_ENABLED=false
POLL_INTERVAL_MS=15000
# Exact approved HTTPS destinations for payment events, comma separated.
# Private/local network destinations are rejected even when allowlisted.
WEBHOOK_ALLOWED_ORIGINS=
