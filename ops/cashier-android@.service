# Example: systemctl start cashier-android@MERCHANT_UUID
# Create/bind the AVD first. The service user needs access to /dev/kvm.
[Unit]
Description=Dedicated Android for cashier %i
After=network-online.target

[Service]
Type=simple
User=cashier
Group=cashier
WorkingDirectory=/opt/android-cashier
EnvironmentFile=/opt/android-cashier/.env
ExecStart=/usr/bin/node scripts/android.mjs start %i --headless
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
