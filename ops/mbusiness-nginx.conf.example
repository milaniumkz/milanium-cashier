# Separate Nginx INSTANCE. Never include this as a site in MTaxi's Nginx.
# Start only after checking the chosen port is unused and installing valid TLS certificates.
# nginx -p /srv/mbusiness/proxy/ -c /srv/mbusiness/proxy/nginx.conf
user mbusiness;
worker_processes 1;
pid /srv/mbusiness/proxy/nginx.pid;
error_log /srv/mbusiness/proxy/error.log warn;
events { worker_connections 256; }
http {
    access_log /srv/mbusiness/proxy/access.log;
    client_max_body_size 32k;
    client_body_temp_path /srv/mbusiness/proxy/client-temp;
    proxy_temp_path /srv/mbusiness/proxy/proxy-temp;
    fastcgi_temp_path /srv/mbusiness/proxy/fastcgi-temp;
    uwsgi_temp_path /srv/mbusiness/proxy/uwsgi-temp;
    scgi_temp_path /srv/mbusiness/proxy/scgi-temp;
    server {
        listen 8443 ssl;
        server_name mbusiness.example.kz;
        ssl_certificate /srv/mbusiness/proxy/tls/fullchain.pem;
        ssl_certificate_key /srv/mbusiness/proxy/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        location /accounting-api/ {
            client_max_body_size 11m;
            proxy_pass http://127.0.0.1:3181;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_read_timeout 60s;
        }
        location / {
            proxy_pass http://127.0.0.1:3181;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            # Replace, do not append an attacker-supplied chain.
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_read_timeout 60s;
        }
    }
}
