# Node does not load this automatically. Use node --env-file=.env src/main.js.
HOST=127.0.0.1
PORT=8080
DATA_DIR=./var
# Exact browser origin, no trailing slash. Empty means no cross-origin access.
CORS_ORIGIN=
# Public registration is off by default. Enable only for controlled onboarding.
ALLOW_REGISTRATION=false
NODE_ENV=production
