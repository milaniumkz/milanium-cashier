{
  "name": "milanium-cashier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "connect": "node --env-file-if-exists=.env scripts/connect.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:http": "node test/http-smoke.mjs",
    "check": "node scripts/check.mjs",
    "android": "node --env-file-if-exists=.env scripts/android.mjs",
    "mac": "node scripts/mac.mjs",
    "init:kaspi": "node scripts/init-kaspi.mjs",
    "start:kaspi": "node --env-file=.env.kaspi src/server.js",
    "test:browser": "node test/business-browser.mjs",
    "test:retail": "node test/retail-browser.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "qrcode": "^1.5.4",
    "undici": "^7.30.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "playwright-core": "^1.57.0"
  }
}
